# systemd unit for mirage-trap. Install:
#   sudo useradd --system --home /opt/mirage-trap --shell /usr/sbin/nologin mirage
#   sudo cp deploy/mirage-trap.service deploy/mirage-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mirage-trap mirage-dashboard
#
# Ports: the trap listens on unprivileged ports (8080 / 2222 / 2323). Expose them as
# 80 / 22 / 23 with deploy/iptables.sh (move the real sshd to another port first!),
# or put deploy/nginx.conf in front for HTTP/HTTPS. Never run the trap as root.

[Unit]
Description=mirage-trap deception honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirage
Group=mirage
WorkingDirectory=/opt/mirage-trap
ExecStart=/opt/mirage-trap/.venv/bin/mirage-trap --config /opt/mirage-trap/config.toml run
Restart=on-failure
RestartSec=3

# hardening: the trap needs its data dir and the network, nothing else
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mirage-trap/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
