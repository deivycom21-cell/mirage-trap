# Local dashboard (127.0.0.1:9090, read-only). Reach it through an SSH tunnel:
#   ssh -L 9090:127.0.0.1:9090 sensor   ->   http://127.0.0.1:9090/?token=<data/dashboard.token>

[Unit]
Description=mirage-trap dashboard (loopback only)
After=mirage-trap.service

[Service]
Type=simple
User=mirage
Group=mirage
WorkingDirectory=/opt/mirage-trap
ExecStart=/opt/mirage-trap/.venv/bin/mirage-trap --config /opt/mirage-trap/config.toml dashboard
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# The database is opened read-only (mode=ro), but SQLite in WAL mode still needs to
# map the shared-memory index (mirage.db-shm) that lives next to it.
ReadWritePaths=/opt/mirage-trap/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
